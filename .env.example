# ---- CodeFlow Explorer configuration -------------------------------------------------------
# Copy to .env and adjust. Every value has a sensible default; nothing here is required.

# Optional, local testing only. Prefills the Connect screen in dev. Never commit a real key.
ANTHROPIC_API_KEY=

# Comma-separated model ids shown before a key is tested. Overrides backend/config/models.json.
DEFAULT_MODEL_FALLBACKS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5

# Upload limits
MAX_UPLOAD_MB=200
MAX_UNZIPPED_MB=1024
MAX_FILES=20000

# Spending guard per project (USD). Analysis pauses and asks before exceeding it.
MAX_COST_PER_PROJECT_USD=5

# How many Claude calls may run at once.
LLM_CONCURRENCY=4

# Background pre-generation stops after this many nodes; the rest is generated on click.
BACKGROUND_MAX_NODES=200

# Secret used to encrypt remembered API keys at rest. Auto-generated into workspace/ if empty.
KEY_ENCRYPTION_SECRET=

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/codeflow.db
WORKSPACE_DIR=./workspace
WORKSPACE_RETENTION_DAYS=7

# Networking
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_ENV=dev
LOG_LEVEL=INFO

# "anthropic" (default) or "mock" (deterministic fake Claude for tests/demos, no key needed)
LLM_MODE=anthropic
